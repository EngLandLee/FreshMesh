{
  "name": "FreshMesh-DXOS tooling",
  "build": { "dockerfile": "Dockerfile" },
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22.14.0" },
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": { "version": "27.5.1", "moby": false },
    "ghcr.io/devcontainers/features/java:1": { "version": "21", "installMaven": true }
  },
  "runArgs": ["--network=host"],
  "remoteUser": "vscode",
  "postCreateCommand": "curl --proto '=https' --tlsv1.2 -LsSf https://astral.sh/uv/0.11.1/install.sh | sudo env UV_INSTALL_DIR=/usr/local/bin sh",
  "forwardPorts": [3180],
  "portsAttributes": {
    "3180": { "label": "FreshMesh portal", "onAutoForward": "notify" }
  },
  "customizations": {
    "vscode": {
      "settings": { "python.defaultInterpreterPath": "/usr/local/bin/python" }
    }
  }
}
