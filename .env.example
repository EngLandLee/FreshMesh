# FreshMesh-DXOS local demonstration defaults (change every secret outside a demo).
# SPDX-License-Identifier: Apache-2.0
# Copyright 2026 FreshMesh-DXOS contributors
POSTGRES_DB=freshmesh
POSTGRES_USER=freshmesh
POSTGRES_PASSWORD=demo-postgres-password
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=demo-keycloak-admin
S3_ACCESS_KEY=freshmesh-access
S3_SECRET_KEY=demo-seaweed-secret
S3_BUCKET=freshmesh-documents
# Public browser URL; Keycloak and backend use the same issuer behind nginx.
PORTAL_URL=http://localhost:3180
KEYCLOAK_ISSUER=http://localhost:3180/auth/realms/freshmesh
KEYCLOAK_JWKS_URL=http://keycloak:8080/auth/realms/freshmesh/protocol/openid-connect/certs
# The imported demo client allows direct grants for CLI smoke checks only; portal uses Authorization Code + PKCE S256.
KEYCLOAK_DEMO_DIRECT_GRANTS_DOCUMENTED=true
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b
